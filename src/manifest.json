{
  "manifest_version": 3,
  "name": "Ed's Mail Helper",
  "version": "1.0.0",
  "description": "Review email by sender and clean it up: trash, keep, or file into folders. Acts on mail only when you click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "eds-mail-helper@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Ed's Mail Helper Dashboard",
    "default_label": "Mail Helper",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "storage",
    "menus",
    "compose",
    "compose.send"
  ]
}
